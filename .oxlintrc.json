{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxlint/schemas/oxlintrc.json",
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "warn",
    "no-explicit-any": "warn",
    "no-empty-object-type": "off",
    "eslint/no-useless-constructor": "off",
    "no-shadow": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "unicorn/no-new-array": "off",
    "no-constant-binary-expression": "off",
    "const-comparisons": "off"
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "*.config.js",
    "*.config.mjs"
  ]
}