{
  "name": "@marivo/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist/**",
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./counter-button": {
      "import": {
        "types": "./dist/es/counter-button.d.mts",
        "default": "./dist/es/counter-button.mjs"
      },
      "require": {
        "types": "./dist/cjs/counter-button.d.ts",
        "default": "./dist/cjs/counter-button.js"
      }
    },
    "./link": {
      "import": {
        "types": "./dist/es/link.d.mts",
        "default": "./dist/es/link.mjs"
      },
      "require": {
        "types": "./dist/cjs/link.d.ts",
        "default": "./dist/cjs/link.js"
      }
    }
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/ --deny-warnings",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@marivo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "bunchee": "^7.0.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@types/react": ">=18",
    "@types/react-dom": ">=18",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "jest": {
  }
}