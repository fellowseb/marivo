  "exports": {
    ".": "./dist/api.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@clerk/backend": "3.26.5",
    "@clerk/express": "2.1.86",
    "@marivo/utils": "workspace:*",
    "@trpc/server": "^11.22.1",
    "@types/cors": "^2.8.19",
    "bullmq": "^6.5.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "postgres": "^4.0.0",
    "superjson": "^2.2.6",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@marivo/eslint-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "types": "link:@clerk/shared/types",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "@jest/globals": "^30.2.0",
    "@marivo/jest-presets": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5"
