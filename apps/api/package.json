{
  "name": "@marivo/api",
  "version": "1.0.0",
  "description": "Marivo API Server",
  "keywords": [],
  "license": "ISC",
  "author": "Sébastien Wauquier",
  "type": "module",
  "exports": {
    ".": "./dist/api.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --inspect --env-file-if-exists=.env.development.local --watch-path=./src --watch-path=./types --watch-path=../../packages src/index.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/ --deny-warnings",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@clerk/backend": "3.27.0",
    "@clerk/express": "2.1.88",
    "@marivo/utils": "workspace:*",
    "@trpc/server": "^11.17.0",
    "@types/cors": "^2.8.19",
    "bullmq": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.7.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "postgres": "^4.0.0",
    "superjson": "^2.2.6",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.0.0",
    "globals": "^17.0.0",
    "supertest": "^7.1.4",
    "testcontainers": "^12.0.0",
    "types": "link:@clerk/shared/types",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
