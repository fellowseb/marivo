{
  "name": "@marivo/api",
  "version": "1.0.0",
  "description": "Marivo API Server",
  "keywords": [],
  "license": "ISC",
  "author": "S\u00e9bastien Wauquier",
  "type": "module",
  "exports": {
    ".": "./dist/api.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --inspect --watch-path=./src --watch-path=./types src/index.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/ --deny-warnings",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --include \"**/*.integration.test.ts\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@clerk/backend": "3.4.7",
    "@clerk/express": "2.1.15",
    "@marivo/utils": "workspace:*",
    "@trpc/server": "^11.17.0",
    "@types/cors": "^2.8.19",
    "bullmq": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.7.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "postgres": "^4.0.0",
    "superjson": "^2.2.6",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/supertest": "^7.0.0",
    "globals": "^16.5.0",
    "supertest": "^7.1.4",
    "types": "link:@clerk/shared/types",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}