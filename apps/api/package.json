{
  "name": "@marivo/api",
  "version": "1.0.0",
  "description": "Marivo API Server",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --inspect --watch-path=./src --watch-path=./types src/index.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings=0",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=\".*integration\\.test\\.ts\"",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=\".*integration\\.test\\.ts\""
  },
  "keywords": [],
  "author": "S\u00e9bastien Wauquier",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "exports": {
    ".": "./dist/api.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@clerk/backend": "3.4.7",
    "@clerk/express": "2.1.15",
    "@marivo/utils": "workspace:*",
    "@trpc/server": "^11.17.0",
    "@types/cors": "^2.8.19",
    "bullmq": "^5.76.8",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "superjson": "^2.2.6",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@marivo/eslint-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "types": "link:@clerk/shared/types",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "@jest/globals": "^30.2.0",
    "@marivo/jest-presets": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5"
  }
}