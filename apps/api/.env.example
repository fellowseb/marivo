CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_ENDPOINT=
# Admin API (used to auto-provision key + bucket on first boot when the
# access/secret keys above are empty)
GARAGE_ADMIN_URL=http://garage:3903
GARAGE_ADMIN_TOKEN=
IMPORT_SCRIPTS_MISTRAL_API_KEY_DEV=
# Env vars map onto apps/api/config/default.json entries via ENV_VAR_MAP
# in src/infra/config.ts (env always overrides the JSON files).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=marivo
# Connection pool settings (timeouts/lifetime in seconds)
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_IDLE_TIMEOUT=20
POSTGRES_MAX_LIFETIME=1800
REDIS_HOST=redis
REDIS_PORT=6379
WORKER_API_KEY=
