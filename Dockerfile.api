FROM node:24-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/config-eslint/package.json packages/config-eslint/package.json
COPY packages/config-typescript/package.json packages/config-typescript/package.json
COPY packages/jest-presets/package.json packages/jest-presets/package.json
COPY packages/utils/package.json packages/utils/package.json

# Install dependencies (including workspaces)
RUN pnpm install --frozen-lockfile

# Copy the rest of the monorepo (but only what's needed)
COPY apps/api/ apps/api/
COPY packages/ packages/

# Build the API (if needed)
WORKDIR /app/apps/api
RUN pnpm build  # Or "pnpm run build" if using a script

# Switch back to root for runtime (optional)
WORKDIR /app

# Start the API
CMD ["pnpm", "--filter", "api", "dev"]
