FROM node:26-alpine

# Install pnpm (corepack is no longer bundled with Node 26 images)
RUN npm install -g pnpm@12.15.0

# Set working directory
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/config-typescript/package.json packages/config-typescript/package.json
COPY packages/utils/package.json packages/utils/package.json

# Install dependencies (including workspaces)
RUN pnpm install --frozen-lockfile

# Copy the rest of the monorepo (but only what's needed)
COPY apps/api/ apps/api/
COPY packages/ packages/

# Build the API (if needed)
WORKDIR /app/apps/api
RUN pnpm build  # Or "pnpm run build" if using a script

# Switch back to root for runtime (optional)
WORKDIR /app

# Start the API
CMD ["pnpm", "--filter", "api", "dev"]
