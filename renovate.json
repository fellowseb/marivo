{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "3 days",
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/Paris",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "branchConcurrentLimit": 10,
  "labels": ["build", "priority:low"],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Major updates: separate PR, no automerge, longer window",
      "matchUpdateTypes": ["major"],
      "labels": ["build", "priority:medium"],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group minor/patch npm updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major npm dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Pin TypeScript (v7 breaks peer deps)",
      "matchPackageNames": ["typescript"],
      "enabled": false
    },
    {
      "description": "Pin eslint to v9 (v10 breaks react plugin peer deps)",
      "matchPackageNames": ["eslint", "@eslint/js"],
      "allowedVersions": "^9"
    },
    {
      "description": "Python dependencies",
      "matchManagers": ["pip_requirements"],
      "labels": ["build", "priority:low"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "priority:critical"],
    "automerge": false,
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "prBodyNotes": ["{{#if isVulnerability}}Security update - fixes a known vulnerability.{{/if}}"]
}
